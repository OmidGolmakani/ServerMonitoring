{
  "Monitoring": {
    "SampleIntervalMilliseconds": 1000,
    "FlushIntervalMilliseconds": 2000,
    "RetentionHours": 24,
    "DataDirectory": "data",
    "DomainProbeIntervalMilliseconds": 60000,
    "DomainProbeTimeoutMilliseconds": 5000,
    "DomainProbeMaxConcurrency": 5,
    "ServerSampleIntervalMilliseconds": 15000,
    "DiscoverIisSites": true,
    "TopProcessLimit": 12,
    "ProcessNamesToSample": [ "w3wp", "dotnet" ],
    "Domains": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
